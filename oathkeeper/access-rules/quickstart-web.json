[
    {
      "id": "quickstart:web:anonymous",
      "upstream": {
        "preserve_host": true,
        "url": "http://localhost:3000/",
        "strip_path": "/.factly/quickstart"
      },
      "match": {
        "url": "http://127.0.0.1:4455/.factly/quickstart/unprotected",
        "methods": [
          "GET"
        ]
      },
      "authenticators": [
        {
          "handler": "anonymous"
        }
      ],
      "authorizer": {
        "handler": "allow"
      },
      "mutators": [
        {
          "handler": "noop"
        }
      ]
    },
    {
      "id": "quickstart:web:protected",
      "upstream": {
        "preserve_host": true,
        "url": "http://localhost:3000/",
        "strip_path": "/.factly/quickstart"
        
      },
      "match": {
        "url": "http://127.0.0.1:4455/.factly/quickstart/blog",
        "methods": [
          "GET"
        ]
      },
      "authenticators": [
        {
          "handler": "cookie_session"
        }
      ],
      "authorizer": {
        "handler": "allow"
      },
      "mutators": [
        {
          "handler": "noop"
        }
      ],
      "errors": [
        {
          "handler": "redirect",
          "config": {
            "to": "http://127.0.0.1:4455/.factly/kavach/web/auth/login",
            "return_to_query_param": "return_to"
          }
        }
      ]
    }
  ]
  