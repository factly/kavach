FROM node:22-alpine AS build
WORKDIR /app

# install node modules
COPY ./package.json ./
COPY ./package-lock.json ./
RUN npm ci --silent --legacy-peer-deps

# copy source files to image and build
COPY . .
# keep the webpack runtime out of index.html so the CSP needs no inline script
ENV INLINE_RUNTIME_CHUNK=false
# webpack 4 (react-scripts 3) hashes with md4, which OpenSSL 3 only has in the legacy provider
ENV NODE_OPTIONS=--openssl-legacy-provider
RUN npm run build

# production environment
FROM nginx:1.30.5-alpine@sha256:0985e772fb9f729e6fa0980da05fca5d9c468e870eed43071545afa9d2e27d94
COPY --from=build /app/build /usr/share/nginx/html
COPY nginx/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]